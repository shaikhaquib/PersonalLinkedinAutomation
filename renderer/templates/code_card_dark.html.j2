<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@500;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { width: 1080px; overflow: hidden; }

  :root {
    --paper:   #12141a;
    --surface: #1a1d26;
    --border:  rgba(255,255,255,0.09);
    --ink:     #f3f4f6;
    --muted:   #9ca3af;
    --accent:  #7c6cff;
    --good:    #34d399;
    --bad:     #f87171;
    --codebg:  #0d1117;
  }

  .page {
    width: 1080px;
    background: var(--paper);
    position: relative; overflow: hidden;
    font-family: 'DM Sans', sans-serif;
  }

  .page::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 70% 45% at 15% 0%, rgba(124,108,255,0.12), transparent 55%),
      radial-gradient(ellipse 50% 35% at 90% 10%, rgba(52,211,153,0.08), transparent 50%);
    pointer-events: none;
  }

  .content {
    position: relative;
    padding: 56px 56px 48px;
    z-index: 1;
  }

  .top-row {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 28px;
  }

  .category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px; font-weight: 700; letter-spacing: 1.6px;
    color: var(--accent);
    text-transform: uppercase;
  }

  .lang-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: 700; letter-spacing: 1px;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 12px;
    background: rgba(255,255,255,0.03);
  }

  .headline {
    font-size: 58px; font-weight: 800; line-height: 1.02;
    letter-spacing: -1.2px; color: var(--ink);
    margin-bottom: 6px;
  }

  .subhead {
    font-size: 42px; font-weight: 700; line-height: 1.08;
    letter-spacing: -0.6px; color: var(--accent);
    margin-bottom: 14px;
  }

  .tagline {
    font-size: 20px; font-weight: 500; line-height: 1.45;
    color: var(--muted); max-width: 820px;
    margin-bottom: 34px;
  }

  .compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 28px;
  }

  .code-panel {
    background: var(--codebg);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(0,0,0,0.35);
  }

  .code-panel.bad { border-color: rgba(248,113,113,0.28); }
  .code-panel.good { border-color: rgba(52,211,153,0.28); }

  .panel-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: rgba(255,255,255,0.03);
  }

  .panel-dots { display: flex; gap: 7px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.12); }

  .panel-filename {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px; font-weight: 500; color: var(--muted);
    margin-left: 10px; flex: 1;
  }

  .panel-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 700; letter-spacing: 0.6px;
    padding: 4px 10px; border-radius: 999px;
  }
  .panel-badge.bad { color: var(--bad); background: rgba(248,113,113,0.12); border: 1px solid rgba(248,113,113,0.25); }
  .panel-badge.good { color: var(--good); background: rgba(52,211,153,0.12); border: 1px solid rgba(52,211,153,0.25); }

  .code-body {
    padding: 18px 18px 20px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px; line-height: 1.65;
    white-space: pre-wrap; word-break: break-word;
    color: #e5e7eb;
  }

  .kw  { color: #c4b5fd; }
  .fn  { color: #7dd3fc; }
  .str { color: #86efac; }
  .cm  { color: #6b7280; }
  .ty  { color: #fbbf24; }
  .an  { color: #f472b6; }
  .hl-bad { background: rgba(248,113,113,0.16); border-radius: 4px; }
  .hl-good { background: rgba(52,211,153,0.14); border-radius: 4px; }

  .takeaways {
    list-style: none;
    display: grid; gap: 12px;
    margin-bottom: 24px;
  }

  .takeaways li {
    font-size: 19px; font-weight: 600; line-height: 1.45;
    color: var(--ink);
    padding-left: 28px; position: relative;
  }

  .takeaways li::before {
    content: "→";
    position: absolute; left: 0; top: 0;
    color: var(--accent); font-weight: 800;
  }

  .footer {
    display: flex; align-items: center; justify-content: space-between;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }

  .footer-name {
    font-size: 20px; font-weight: 700; color: var(--ink);
  }

  .footer-role {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px; color: var(--muted); margin-top: 4px;
  }

  .footer-mark {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: 700; letter-spacing: 1px;
    color: var(--muted);
  }
</style>
</head>
<body>
<div class="page" id="page">
  <div class="content">

    <div class="top-row">
      <div class="category">{{ category }}</div>
      <div class="lang-pill">Kotlin</div>
    </div>

    <div class="headline" id="headline">{{ headline }}</div>
    <div class="subhead" id="subhead">{{ subhead }}</div>
    <div class="tagline">{{ tagline }}</div>

    <div class="compare-grid">
      <div class="code-panel bad">
        <div class="panel-head">
          <div class="panel-dots"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
          <div class="panel-filename">{{ before_label }}</div>
          <div class="panel-badge bad">BEFORE</div>
        </div>
        <div class="code-body">{{ before_code_html | safe }}</div>
      </div>

      <div class="code-panel good">
        <div class="panel-head">
          <div class="panel-dots"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
          <div class="panel-filename">{{ after_label }}</div>
          <div class="panel-badge good">AFTER</div>
        </div>
        <div class="code-body">{{ after_code_html | safe }}</div>
      </div>
    </div>

    <ul class="takeaways">
      {% for item in takeaways %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>

    <div class="footer">
      <div>
        <div class="footer-name">Aquib Rashid Shaikh</div>
        <div class="footer-role">Senior Android Developer &amp; Mobile Tech Lead</div>
      </div>
      <div class="footer-mark">ANDROID / KOTLIN</div>
    </div>

  </div>
</div>

<script>
window.drawInfographic = function() {
  function shrink(el, maxWidth, minSize) {
    if (!el) return;
    var sz = parseFloat(getComputedStyle(el).fontSize);
    while (el.scrollWidth > maxWidth && sz > minSize) {
      sz -= 1;
      el.style.fontSize = sz + 'px';
    }
  }
  shrink(document.getElementById('headline'), 960, 34);
  shrink(document.getElementById('subhead'), 960, 26);

  var page = document.getElementById('page');
  var content = document.querySelector('.content');
  var h = Math.ceil(content.getBoundingClientRect().height);
  page.style.height = Math.max(600, Math.min(1500, h)) + 'px';
};
document.fonts.ready.then(function() { window.drawInfographic(); });
</script>
</body>
</html>
