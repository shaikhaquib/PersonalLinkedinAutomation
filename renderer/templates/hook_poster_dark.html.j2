<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@500;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { width: 1080px; overflow: hidden; }

  :root {
    --paper:   #0e1116;
    --surface: #171b22;
    --border:  rgba(255,255,255,0.10);
    --ink:     #f5f7fa;
    --muted:   #9aa3b2;
    --accent:  #2dd4bf;
    --warn:    #fb923c;
    --bad:     #f87171;
    --good:    #34d399;
  }

  .page {
    width: 1080px;
    background: var(--paper);
    position: relative; overflow: hidden;
    font-family: 'DM Sans', sans-serif;
  }

  .page::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 0% 0%, rgba(251,146,60,0.18), transparent 55%),
      radial-gradient(ellipse 60% 40% at 100% 20%, rgba(45,212,191,0.14), transparent 50%),
      linear-gradient(160deg, rgba(255,255,255,0.02), transparent 40%);
    pointer-events: none;
  }

  .content {
    position: relative;
    padding: 52px 56px 44px;
    z-index: 1;
  }

  .top-row {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 36px;
  }

  .category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px; font-weight: 700; letter-spacing: 1.8px;
    color: var(--warn);
    text-transform: uppercase;
  }

  .lang-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: 700; letter-spacing: 1px;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 12px;
    background: rgba(255,255,255,0.03);
  }

  .hook-line {
    font-size: 64px; font-weight: 800; line-height: 1.02;
    letter-spacing: -1.6px; color: var(--ink);
    max-width: 960px;
    margin-bottom: 10px;
  }

  .punch-line {
    font-size: 40px; font-weight: 700; line-height: 1.12;
    letter-spacing: -0.8px; color: var(--accent);
    max-width: 920px;
    margin-bottom: 22px;
  }

  .stakes {
    font-size: 22px; font-weight: 500; line-height: 1.45;
    color: var(--muted); max-width: 880px;
    margin-bottom: 36px;
  }

  .contrast {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 34px;
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 26px 28px;
    min-height: 160px;
  }

  .panel.bad { border-color: rgba(248,113,113,0.35); }
  .panel.good { border-color: rgba(52,211,153,0.35); }

  .panel-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: 700; letter-spacing: 1.4px;
    margin-bottom: 12px; text-transform: uppercase;
  }
  .panel.bad .panel-label { color: var(--bad); }
  .panel.good .panel-label { color: var(--good); }

  .panel-text {
    font-size: 26px; font-weight: 700; line-height: 1.28;
    color: var(--ink); letter-spacing: -0.3px;
  }

  .bullets {
    display: flex; flex-direction: column; gap: 14px;
    margin-bottom: 36px;
  }

  .bullet {
    display: flex; gap: 14px; align-items: flex-start;
    font-size: 20px; font-weight: 500; line-height: 1.4;
    color: var(--ink);
  }

  .bullet::before {
    content: '→';
    color: var(--accent);
    font-weight: 800;
    flex-shrink: 0;
  }

  .footer {
    display: flex; justify-content: space-between; align-items: flex-end;
    border-top: 1px solid var(--border);
    padding-top: 22px;
  }

  .author-name {
    font-size: 18px; font-weight: 700; color: var(--ink);
  }
  .author-title {
    font-size: 14px; font-weight: 500; color: var(--muted); margin-top: 4px;
  }
  .footer-right {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: 700; letter-spacing: 1.2px;
    color: var(--muted);
  }
</style>
</head>
<body>
<div class="page">
  <div class="content">
    <div class="top-row">
      <div class="category">{{ category }}</div>
      <div class="lang-pill">Android</div>
    </div>

    <div class="hook-line">{{ hook_line }}</div>
    <div class="punch-line">{{ punch_line }}</div>
    <div class="stakes">{{ stakes }}</div>

    <div class="contrast">
      <div class="panel bad">
        <div class="panel-label">{{ contrast_left.label }}</div>
        <div class="panel-text">{{ contrast_left.text }}</div>
      </div>
      <div class="panel good">
        <div class="panel-label">{{ contrast_right.label }}</div>
        <div class="panel-text">{{ contrast_right.text }}</div>
      </div>
    </div>

    <div class="bullets">
      {% for b in bullets %}
      <div class="bullet">{{ b }}</div>
      {% endfor %}
    </div>

    <div class="footer">
      <div>
        <div class="author-name">Aquib Rashid Shaikh</div>
        <div class="author-title">Senior Android Developer &amp; Mobile Tech Lead</div>
      </div>
      <div class="footer-right">ANDROID / KOTLIN</div>
    </div>
  </div>
</div>
<script>
function drawInfographic() {
  const page = document.querySelector('.page');
  const content = document.querySelector('.content');
  const h = Math.min(1500, Math.max(600, content.scrollHeight + 8));
  page.style.height = h + 'px';
  document.body.style.height = h + 'px';
}
drawInfographic();
</script>
</body>
</html>
