<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@500;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { width: 1080px; overflow: hidden; }

  :root {
    --paper:   #12141a;
    --surface: #1a1d26;
    --border:  rgba(255,255,255,0.09);
    --ink:     #f3f4f6;
    --muted:   #9ca3af;
    --accent:  #7c6cff;
    --cyan:    #34d399;
    --codebg:  #0d1117;
  }

  .page {
    width: 1080px;
    background: var(--paper);
    position: relative; overflow: hidden;
    font-family: 'DM Sans', sans-serif;
  }

  .page::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 70% 45% at 15% 0%, rgba(124,108,255,0.12), transparent 55%),
      radial-gradient(ellipse 50% 35% at 90% 10%, rgba(52,211,153,0.08), transparent 50%);
    pointer-events: none;
  }

  .content {
    position: relative;
    padding: 56px 56px 48px;
    z-index: 1;
  }

  .top-row {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 28px;
  }

  .category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px; font-weight: 700; letter-spacing: 1.6px;
    color: var(--accent);
    text-transform: uppercase;
  }

  .lang-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: 700; letter-spacing: 1px;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 12px;
    background: rgba(255,255,255,0.03);
  }

  .headline {
    font-size: 58px; font-weight: 800; line-height: 1.02;
    letter-spacing: -1.2px; color: var(--ink);
    margin-bottom: 6px;
  }

  .subhead {
    font-size: 42px; font-weight: 700; line-height: 1.08;
    letter-spacing: -0.6px; color: var(--accent);
    margin-bottom: 14px;
  }

  .tagline {
    font-size: 20px; font-weight: 500; line-height: 1.45;
    color: var(--muted); max-width: 820px;
    margin-bottom: 34px;
  }

  .flow-row {
    display: grid;
    grid-template-columns: 1fr 40px 1fr 40px 1fr;
    align-items: stretch;
    gap: 0;
    margin-bottom: 28px;
  }

  .flow-arrow {
    display: flex; align-items: center; justify-content: center;
    color: var(--accent); font-size: 28px; font-weight: 800;
    opacity: 0.75;
  }

  .flow-node {
    background: var(--codebg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 22px 18px 20px;
    min-height: 120px;
    box-shadow: 0 18px 40px rgba(0,0,0,0.35);
    display: flex; flex-direction: column; justify-content: center;
  }

  .flow-node.highlight {
    border-color: rgba(52,211,153,0.35);
    box-shadow: 0 18px 40px rgba(0,0,0,0.35), 0 0 0 1px rgba(52,211,153,0.15) inset;
    background: linear-gradient(180deg, rgba(52,211,153,0.08) 0%, var(--codebg) 100%);
  }

  .node-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: 700; letter-spacing: 1.2px;
    color: var(--cyan); text-transform: uppercase;
    margin-bottom: 10px;
  }

  .flow-node.highlight .node-label { color: var(--cyan); }

  .node-title {
    font-size: 24px; font-weight: 800; line-height: 1.15;
    color: var(--ink); margin-bottom: 10px;
  }

  .node-detail {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px; font-weight: 500; line-height: 1.5;
    color: #c7d2fe; word-break: break-word;
  }

  .takeaways {
    list-style: none;
    display: grid; gap: 12px;
    margin-bottom: 24px;
  }

  .takeaways li {
    font-size: 19px; font-weight: 600; line-height: 1.45;
    color: var(--ink);
    padding-left: 28px; position: relative;
  }

  .takeaways li::before {
    content: "→";
    position: absolute; left: 0; top: 0;
    color: var(--accent); font-weight: 800;
  }

  .footer {
    display: flex; align-items: center; justify-content: space-between;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }

  .footer-name { font-size: 20px; font-weight: 700; color: var(--ink); }
  .footer-role {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px; color: var(--muted); margin-top: 4px;
  }
  .footer-mark {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: 700; letter-spacing: 1px;
    color: var(--muted);
  }
</style>
</head>
<body>
<div class="page" id="page">
  <div class="content">

    <div class="top-row">
      <div class="category">{{ category }}</div>
      <div class="lang-pill">Android</div>
    </div>

    <div class="headline" id="headline">{{ headline }}</div>
    <div class="subhead" id="subhead">{{ subhead }}</div>
    <div class="tagline">{{ tagline }}</div>

    <div class="flow-row">
      <div class="flow-node{% if flow_nodes[0].highlight %} highlight{% endif %}">
        <div class="node-label">Step 1</div>
        <div class="node-title">{{ flow_nodes[0].label }}</div>
        <div class="node-detail">{{ flow_nodes[0].detail }}</div>
      </div>
      <div class="flow-arrow">→</div>
      <div class="flow-node{% if flow_nodes[1].highlight %} highlight{% endif %}">
        <div class="node-label">Step 2</div>
        <div class="node-title">{{ flow_nodes[1].label }}</div>
        <div class="node-detail">{{ flow_nodes[1].detail }}</div>
      </div>
      <div class="flow-arrow">→</div>
      <div class="flow-node{% if flow_nodes[2].highlight %} highlight{% endif %}">
        <div class="node-label">Step 3</div>
        <div class="node-title">{{ flow_nodes[2].label }}</div>
        <div class="node-detail">{{ flow_nodes[2].detail }}</div>
      </div>
    </div>

    <ul class="takeaways">
      {% for item in takeaways %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>

    <div class="footer">
      <div>
        <div class="footer-name">Aquib Rashid Shaikh</div>
        <div class="footer-role">Senior Android Developer &amp; Mobile Tech Lead</div>
      </div>
      <div class="footer-mark">ANDROID / KOTLIN</div>
    </div>

  </div>
</div>

<script>
window.drawInfographic = function() {
  function shrink(el, maxWidth, minSize) {
    if (!el) return;
    var sz = parseFloat(getComputedStyle(el).fontSize);
    while (el.scrollWidth > maxWidth && sz > minSize) {
      sz -= 1;
      el.style.fontSize = sz + 'px';
    }
  }
  shrink(document.getElementById('headline'), 960, 34);
  shrink(document.getElementById('subhead'), 960, 26);

  var page = document.getElementById('page');
  var content = document.querySelector('.content');
  var h = Math.ceil(content.getBoundingClientRect().height);
  page.style.height = Math.max(600, Math.min(1500, h)) + 'px';
};
document.fonts.ready.then(function() { window.drawInfographic(); });
</script>
</body>
</html>
