<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { width: 1080px; overflow: hidden; }

  :root {
    --paper:   #0b0e16;  /* near-black navy page bg */
    --panel:   #161a24;  /* raised-panel surface */
    --panel2:  #1d2231;  /* slightly lighter panel for alternating depth */
    --ink:     #f4f5f7;  /* primary text — off-white */
    --accent:  #a78bfa;  /* bright violet — primary accent */
    --cyan:    #22d3ee;  /* vibrant cyan — secondary accent (replaces emerald and amber) */
    --slate:   #9aa3b4;  /* secondary text */
    --line:    rgba(255,255,255,0.08);
    --codebg:  #0d1117;  /* code block background */
  }

  .page {
    width: 1080px; min-height: 1410px;
    background: var(--paper);
    position: relative; overflow: hidden;
    font-family: 'Inter', sans-serif;
  }

  /* ── subtle background grid ── */
  .page::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(167,139,250,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(167,139,250,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .content { position: absolute; left: 64px; top: 0; right: 64px; bottom: 0; }

  /* ── HARDCODED ATTRIBUTION EYEBROW (D1/D6 fix) ── */
  .eyebrow {
    position: absolute; left: 0; top: 36px; display: flex; align-items: center; gap: 9px;
    background: rgba(167,139,250,0.08); border: 2px solid var(--accent); border-radius: 999px;
    padding: 8px 20px 8px 16px; width: fit-content;
  }
  .eyebrow-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.5} }
  .eyebrow span {
    font-family: 'Inter', sans-serif; font-weight: 800; font-size: 16px;
    color: var(--accent); letter-spacing: 0.4px;
  }
  .corner-mark {
    position: absolute; right: 0; top: 32px;
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 19px;
    color: #0d1117; background: var(--accent); border-radius: 10px;
    padding: 9px 14px;
  }

  /* ── title ── */
  .title-block { position: absolute; left: 0; top: 90px; width: 820px; }
  .h-line {
    font-family: 'Archivo Black', 'Space Grotesk', sans-serif; font-weight: 400; font-size: 60px;
    line-height: 1.08; letter-spacing: -0.5px;
  }
  .h-line.l1 { color: var(--ink); }
  .h-line.l2 { color: var(--accent); text-shadow: 0 0 28px rgba(167,139,250,0.4); }
  .tagline {
    font-family: 'Inter', sans-serif; font-weight: 600; font-size: 22px;
    color: var(--slate); margin-top: 14px;
  }

  .hr { position: absolute; left: 0; width: 952px; height: 1px; background: var(--line); }

  /* ── section label ── */
  .section-rule { position: absolute; left: 0; width: 952px; display: flex; align-items: center; gap: 16px; }
  .section-rule .rule-line { flex: 1; height: 2px; background: var(--accent); opacity: 0.3; }
  .section-rule .rule-text {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 15px;
    letter-spacing: 2px; color: var(--accent); white-space: nowrap;
  }

  /* ── state flow row ── */
  .flow-stage {
    position: absolute;
    display: flex; flex-direction: column; align-items: center;
  }
  .flow-stage .stage-label {
    font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 17px;
    margin-bottom: 10px; text-align: center;
  }
  .flow-node {
    width: 100%; border-radius: 14px;
    padding: 16px 14px; border: 2px solid var(--c);
    background: linear-gradient(135deg, var(--panel) 0%, var(--panel2) 100%);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.02) inset,
                0 0 20px -8px var(--c);
    position: relative; overflow: hidden;
  }
  .flow-node::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: var(--c); border-radius: 14px 14px 0 0;
  }
  .flow-node .node-icon {
    font-family: 'JetBrains Mono', monospace; font-size: 13px;
    color: var(--c); opacity: 0.7; margin-bottom: 6px; font-weight: 700;
  }
  .flow-node .node-code {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 17px;
    color: var(--c); line-height: 1.4;
    word-break: break-all;
  }

  .connector-svg {
    position: absolute;
    pointer-events: none; overflow: visible;
  }

  /* ── technical breakdown cards (replacing generic checkmark grid) ── */
  .breakdown-card {
    position: absolute; border-radius: 16px;
    background: var(--panel2); border: 1px solid var(--line);
    padding: 20px 22px 18px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }
  .bc-header-row {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 8px;
  }
  .breakdown-card .bc-number {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px;
    color: var(--c); letter-spacing: 1px;
  }
  .breakdown-card .bc-title {
    font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 22px;
    color: var(--ink); margin-bottom: 12px; line-height: 1.2; letter-spacing: -0.1px;
  }
  .breakdown-card .bc-pts { list-style: none; }
  .breakdown-card .bc-pts li {
    font-family: 'Inter', sans-serif; font-weight: 500; font-size: 17px;
    color: #ced3dc; line-height: 1.55; padding-left: 22px; position: relative; margin-bottom: 5px;
  }
  .breakdown-card .bc-pts li::before {
    content: "→"; position: absolute; left: 0;
    color: var(--c); font-weight: 700;
  }
  .breakdown-card.bd1 { --c: var(--accent); }
  .breakdown-card.bd2 { --c: var(--cyan); }
  .breakdown-card.bd3 { --c: var(--accent); }
  .breakdown-card.bd4 { --c: var(--cyan); }

  /* ── Phase 5.5a: Confidence Badges & Legend ── */
  .legend-bar {
    position: absolute; left: 0; display: flex; align-items: center; gap: 12px;
  }
  .legend-pill {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 6px 14px; border-radius: 999px;
    font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
  }
  .legend-pill.confirmed {
    background: rgba(34, 211, 238, 0.08); border: 1px solid rgba(34, 211, 238, 0.28); color: var(--cyan);
  }
  .legend-pill.analysis {
    background: rgba(167, 139, 250, 0.08); border: 1px solid rgba(167, 139, 250, 0.28); color: var(--accent);
  }
  .lp-icon { font-size: 13px; font-weight: 900; }

  .confidence-badge {
    font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700;
    padding: 3px 8px; border-radius: 6px; letter-spacing: 0.6px;
    display: inline-flex; align-items: center; gap: 5px; text-transform: uppercase;
  }
  .badge-confirmed {
    background: rgba(34, 211, 238, 0.1); color: var(--cyan); border: 1px solid rgba(34, 211, 238, 0.25);
  }
  .badge-analysis {
    background: rgba(167, 139, 250, 0.1); color: var(--accent); border: 1px solid rgba(167, 139, 250, 0.25);
  }

  /* ── Phase 5.5c: Actionable Closing Block ── */
  .actionable-block {
    position: absolute; left: 0; width: 952px;
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.06) 0%, rgba(167, 139, 250, 0.04) 100%);
    border: 1px solid rgba(34, 211, 238, 0.22); border-radius: 14px;
    padding: 20px 26px; box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }
  .ab-header {
    display: flex; align-items: center; gap: 10px; margin-bottom: 10px;
  }
  .ab-icon {
    font-size: 18px; color: var(--cyan);
  }
  .ab-title {
    font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 16px;
    letter-spacing: 1.5px; color: var(--cyan); text-transform: uppercase;
  }
  .ab-pts { list-style: none; }
  .ab-pts li {
    font-family: 'Inter', sans-serif; font-weight: 500; font-size: 16px;
    color: var(--ink); line-height: 1.55; padding-left: 20px; position: relative; margin-bottom: 6px;
  }
  .ab-pts li:last-child { margin-bottom: 0; }
  .ab-pts li::before {
    content: "✓"; position: absolute; left: 0; color: var(--cyan); font-weight: 800; font-family: 'JetBrains Mono', monospace;
  }

  /* ── insight strip (replaces flow strips + sticky) ── */
  .insight-strip {
    position: absolute; left: 0; width: 952px;
    background: linear-gradient(135deg, rgba(167,139,250,0.08) 0%, rgba(167,139,250,0.03) 100%);
    border: 1px solid rgba(167,139,250,0.25); border-radius: 14px;
    padding: 22px 28px; display: flex; align-items: flex-start; gap: 18px;
  }
  .insight-icon {
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 10px;
    background: rgba(167,139,250,0.15); border: 1px solid rgba(167,139,250,0.3);
    display: flex; align-items: center; justify-content: center;
    font-family: 'JetBrains Mono', monospace; font-size: 18px; color: var(--accent); font-weight: 700;
  }
  .insight-content {}
  .insight-label {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px;
    letter-spacing: 1.5px; color: var(--accent); margin-bottom: 7px;
  }
  .insight-text {
    font-family: 'Inter', sans-serif; font-weight: 600; font-size: 20px;
    color: var(--ink); line-height: 1.5;
  }

  /* ── pipeline chips ── */
  .pipeline-row {
    position: absolute; left: 0; width: 952px;
    display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
  }
  .pipe-label {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px;
    color: var(--slate); letter-spacing: 1px; white-space: nowrap; margin-right: 4px;
  }
  .pipe-chip {
    font-family: 'Inter', sans-serif; font-weight: 700; font-size: 14px; color: var(--ink);
    border: 1.5px solid rgba(255,255,255,0.12); border-radius: 8px; background: var(--panel2);
    padding: 6px 11px; white-space: nowrap;
  }
  .pipe-arrow { color: var(--slate); font-size: 14px; font-weight: 700; }

  /* ── HARDCODED FOOTER (D2 fix) ── */
  .footer {
    position: absolute; left: 0; width: 952px;
    display: flex; align-items: center; justify-content: space-between;
    border-top: 1px solid var(--line); padding-top: 16px;
  }
  .footer-author {
    font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 19px; color: var(--ink);
  }
  .footer-handle {
    font-family: 'JetBrains Mono', monospace; font-weight: 500; font-size: 14px; color: var(--slate); margin-top: 2px;
  }
  .footer-right {
    text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 4px;
  }
  .footer-badge {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 11px;
    color: var(--cyan); background: rgba(34, 211, 238, 0.08); border: 1px solid rgba(34, 211, 238, 0.28);
    padding: 3px 10px; border-radius: 6px; letter-spacing: 0.5px;
  }
  .footer-domain {
    font-family: 'Inter', sans-serif; font-weight: 600; font-size: 14px;
    color: var(--accent); letter-spacing: 0.3px;
  }
</style>
</head>
<body>
<div class="page">
  <div class="content">

    <!-- HARDCODED ATTRIBUTION — D1/D6 FIX: never a template variable -->
    <div class="eyebrow"><div class="eyebrow-dot"></div><span>AQUIB SHAIKH // MOBILE ARCHITECTURE &amp; ANDROID INTERNALS</span></div>
    <div class="corner-mark">&lt;/&gt;</div>

    <div class="title-block">
      <div id="h1" class="h-line l1">{{ title_line1 }}</div>
      <div id="h2" class="h-line l2">{{ title_line2 }}</div>
      <div class="tagline">{{ tagline }}</div>
    </div>

    <!-- Phase 5.5a: Confidence Legend Bar -->
    <div class="legend-bar" id="legendBar">
      <div class="legend-pill confirmed"><span class="lp-icon">✓</span><span>CONFIRMED AOSP SPEC</span></div>
      <div class="legend-pill analysis"><span class="lp-icon">💡</span><span>ENGINEERING ANALYSIS</span></div>
    </div>

    <div class="hr" id="hr1"></div>

    <div class="section-rule" id="sectionRule">
      <span class="rule-line"></span><span class="rule-text">{{ section_label }}</span><span class="rule-line"></span>
    </div>

    <!-- State Flow: 3 nodes connected by SVG arrows (strictly alternating violet and cyan) -->
    <div class="flow-stage" id="stage0" style="left:0px;width:286px">
      <div class="stage-label" style="color:var(--accent)">{{ stages[0].label }}</div>
      <div class="flow-node" style="--c:var(--accent)">
        <div class="node-icon">INPUT //</div>
        <div class="node-code">{{ stages[0].snippet }}</div>
      </div>
    </div>

    <div class="flow-stage" id="stage1" style="left:333px;width:286px">
      <div class="stage-label" style="color:var(--cyan)">{{ stages[1].label }}</div>
      <div class="flow-node" style="--c:var(--cyan)">
        <div class="node-icon">PROCESS //</div>
        <div class="node-code">{{ stages[1].snippet }}</div>
      </div>
    </div>

    <div class="flow-stage" id="stage2" style="left:666px;width:286px">
      <div class="stage-label" style="color:var(--accent)">{{ stages[2].label }}</div>
      <div class="flow-node" style="--c:var(--accent)">
        <div class="node-icon">OUTPUT //</div>
        <div class="node-code">{{ stages[2].snippet }}</div>
      </div>
    </div>

    <svg id="stage-arrows" class="connector-svg" style="left:0;top:0" width="952" height="600">
      <defs>
        <marker id="sarr" markerWidth="12" markerHeight="8" refX="9" refY="4" orient="auto">
          <polygon points="0 0.5, 11 4, 0 7.5" fill="#22d3ee"/>
        </marker>
      </defs>
    </svg>

    <!-- Technical Breakdown Cards: 2x2 grid with Phase 5.5a Confidence Badges -->
    <div class="breakdown-card bd1" id="card0" style="left:0px;width:460px">
      <div class="bc-header-row">
        <div class="bc-number">01</div>
        {% if steps[0].confidence == 'analysis' %}
          <div class="confidence-badge badge-analysis">💡 ARCHITECTURAL READ</div>
        {% else %}
          <div class="confidence-badge badge-confirmed">✓ CONFIRMED SPEC</div>
        {% endif %}
      </div>
      <div class="bc-title">{{ steps[0].label }}</div>
      <ul class="bc-pts">{% for p in steps[0].points %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>
    <div class="breakdown-card bd2" id="card1" style="left:492px;width:460px">
      <div class="bc-header-row">
        <div class="bc-number">02</div>
        {% if steps[1].confidence == 'analysis' %}
          <div class="confidence-badge badge-analysis">💡 ARCHITECTURAL READ</div>
        {% else %}
          <div class="confidence-badge badge-confirmed">✓ CONFIRMED SPEC</div>
        {% endif %}
      </div>
      <div class="bc-title">{{ steps[1].label }}</div>
      <ul class="bc-pts">{% for p in steps[1].points %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>
    <div class="breakdown-card bd3" id="card2" style="left:0px;width:460px">
      <div class="bc-header-row">
        <div class="bc-number">03</div>
        {% if steps[2].confidence == 'analysis' %}
          <div class="confidence-badge badge-analysis">💡 ARCHITECTURAL READ</div>
        {% else %}
          <div class="confidence-badge badge-confirmed">✓ CONFIRMED SPEC</div>
        {% endif %}
      </div>
      <div class="bc-title">{{ steps[2].label }}</div>
      <ul class="bc-pts">{% for p in steps[2].points %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>
    <div class="breakdown-card bd4" id="card3" style="left:492px;width:460px">
      <div class="bc-header-row">
        <div class="bc-number">04</div>
        {% if steps[3].confidence == 'analysis' %}
          <div class="confidence-badge badge-analysis">💡 ARCHITECTURAL READ</div>
        {% else %}
          <div class="confidence-badge badge-confirmed">✓ CONFIRMED SPEC</div>
        {% endif %}
      </div>
      <div class="bc-title">{{ steps[3].label }}</div>
      <ul class="bc-pts">{% for p in steps[3].points %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>

    <!-- Pipeline trace chips (replaces bottom flow strips) -->
    <div class="pipeline-row" id="pipeA">
      <span class="pipe-label">TRACE:</span>
      {% for item in flow_a_items %}<div class="pipe-chip">{{ item }}</div>{% if not loop.last %}<span class="pipe-arrow">→</span>{% endif %}{% endfor %}
    </div>

    <!-- Phase 5.5c: Actionable Closing Block (What This Means For Your Codebase) -->
    <div class="actionable-block" id="actionableBlock">
      <div class="ab-header">
        <div class="ab-icon">💡</div>
        <div class="ab-title">{{ actionable_closing.title if actionable_closing and actionable_closing.title else "WHAT THIS MEANS FOR YOUR CODEBASE" }}</div>
      </div>
      <div class="ab-body">
        <ul class="ab-pts">
          {% if actionable_closing and actionable_closing.points %}
            {% for pt in actionable_closing.points %}<li>{{ pt }}</li>{% endfor %}
          {% else %}
            <li>Audit your codebase for this pattern across critical UI and background execution paths.</li>
            <li>Enforce strict boundary separation between data mapping and presentation logic.</li>
          {% endif %}
        </ul>
      </div>
    </div>

    <!-- Key Insight / Takeaway strip (replaces sticky note — D3 fix) -->
    <div class="insight-strip" id="insightStrip">
      <div class="insight-icon">⚡</div>
      <div class="insight-content">
        <div class="insight-label">KEY INSIGHT</div>
        <div class="insight-text">{{ hook }}</div>
      </div>
    </div>

    <!-- HARDCODED FOOTER (D2 fix) — never a template variable -->
    <div class="footer" id="footer">
      <div>
        <div class="footer-author">Aquib Rashid Shaikh</div>
        <div class="footer-handle">Senior Android Developer &amp; Mobile Tech Lead</div>
      </div>
      <div class="footer-right">
        <div class="footer-badge">OPEN TO STRATEGIC LEADERSHIP &amp; ARCHITECTURE DISCUSSIONS ↗</div>
        <div class="footer-domain">Android Architecture • High-Scale Mobile Systems • Kotlin</div>
      </div>
    </div>

  </div>
</div>

<script>
window._infoDone = false;

window.drawInfographic = function() {
  if (window._infoDone) return;
  window._infoDone = true;

  var content = document.querySelector('.content');
  var cr = content.getBoundingClientRect();

  // ── Shrink title lines if too wide ──
  ['h1','h2'].forEach(function(id) {
    var el = document.getElementById(id);
    if (!el) return;
    var sz = parseFloat(getComputedStyle(el).fontSize);
    while (el.scrollWidth > 800 && sz > 28) { sz -= 2; el.style.fontSize = sz + 'px'; }
  });

  // ── Shrink breakdown card titles if too wide ──
  document.querySelectorAll('.bc-title').forEach(function(el) {
    var sz = parseFloat(getComputedStyle(el).fontSize);
    while (el.scrollWidth > 400 && sz > 15) { sz--; el.style.fontSize = sz + 'px'; }
  });

  // ── Shrink node code snippets if too wide ──
  document.querySelectorAll('.node-code').forEach(function(el) {
    var sz = parseFloat(getComputedStyle(el).fontSize);
    while (el.scrollWidth > 250 && sz > 10) { sz--; el.style.fontSize = sz + 'px'; }
  });

  // ── Position legend bar under title block ──
  var titleBlock = document.querySelector('.title-block');
  var titleBottom = titleBlock.getBoundingClientRect().bottom - cr.top;
  var legendBar = document.getElementById('legendBar');
  var legendTop = titleBottom + 16;
  legendBar.style.top = legendTop + 'px';
  var legendBottom = legendTop + legendBar.getBoundingClientRect().height;

  // ── Position divider under legend bar ──
  var hr1 = document.getElementById('hr1');
  hr1.style.top = (legendBottom + 16) + 'px';

  // ── Position section rule ──
  var sectionRule = document.getElementById('sectionRule');
  var ruleTop = legendBottom + 16 + 22;
  sectionRule.style.top = ruleTop + 'px';
  var ruleH = sectionRule.getBoundingClientRect().height;

  // ── Position 3 flow stages ──
  var stageTop = ruleTop + ruleH + 24;
  ['stage0', 'stage1', 'stage2'].forEach(function(id) {
    document.getElementById(id).style.top = stageTop + 'px';
  });

  // ── Draw arrows between stages ──
  function stageNodeRect(id) {
    var el = document.querySelector('#' + id + ' .flow-node');
    var r = el.getBoundingClientRect();
    return { L: r.left - cr.left, R: r.right - cr.left, cy: (r.top + r.bottom) / 2 - cr.top };
  }
  var s0 = stageNodeRect('stage0'), s1 = stageNodeRect('stage1'), s2 = stageNodeRect('stage2');
  var svg = document.getElementById('stage-arrows');

  function addArrow(x1, y1, x2, y2) {
    var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', x1); line.setAttribute('y1', y1);
    line.setAttribute('x2', x2); line.setAttribute('y2', y2);
    line.setAttribute('stroke', '#a78bfa'); line.setAttribute('stroke-width', '2.5');
    line.setAttribute('stroke-dasharray', '6 3');
    line.setAttribute('marker-end', 'url(#sarr)');
    svg.appendChild(line);
  }
  addArrow(s0.R + 8, s0.cy, s1.L - 8, s1.cy);
  addArrow(s1.R + 8, s1.cy, s2.L - 8, s2.cy);

  // ── Position breakdown card grid ──
  var maxStageBottom = Math.max(
    document.getElementById('stage0').getBoundingClientRect().bottom,
    document.getElementById('stage1').getBoundingClientRect().bottom,
    document.getElementById('stage2').getBoundingClientRect().bottom
  ) - cr.top;

  var row1Top = maxStageBottom + 40;
  var card0 = document.getElementById('card0'), card1 = document.getElementById('card1');
  card0.style.top = row1Top + 'px';
  card1.style.top = row1Top + 'px';
  var row1H = Math.max(card0.getBoundingClientRect().height, card1.getBoundingClientRect().height);

  var row2Top = row1Top + row1H + 24;
  var card2 = document.getElementById('card2'), card3 = document.getElementById('card3');
  card2.style.top = row2Top + 'px';
  card3.style.top = row2Top + 'px';
  var row2H = Math.max(card2.getBoundingClientRect().height, card3.getBoundingClientRect().height);

  // ── Position pipeline trace ──
  var pipeTop = row2Top + row2H + 32;
  var pipeA = document.getElementById('pipeA');
  pipeA.style.top = pipeTop + 'px';
  var pipeH = pipeA.getBoundingClientRect().height;

  // ── Phase 5.5c: Position Actionable Closing Block ──
  var abTop = pipeTop + pipeH + 20;
  var actionableBlock = document.getElementById('actionableBlock');
  actionableBlock.style.top = abTop + 'px';
  var abH = actionableBlock.getBoundingClientRect().height;

  // ── Position insight strip ──
  var insightTop = abTop + abH + 18;
  var insightStrip = document.getElementById('insightStrip');
  insightStrip.style.top = insightTop + 'px';
  var insightH = insightStrip.getBoundingClientRect().height;

  // ── Position footer ──
  var footer = document.getElementById('footer');
  var footerTop = insightTop + insightH + 32;
  footer.style.top = footerTop + 'px';

  // ── Phase 2.8: Dynamically adjust .page height to prevent bottom cropping ──
  var footerBottom = footerTop + footer.getBoundingClientRect().height;
  var totalNeeded = Math.ceil(footerBottom + 40);
  var minH = 1410;
  var finalH = Math.max(minH, Math.min(1950, totalNeeded));
  document.querySelector('.page').style.height = finalH + 'px';
};

document.fonts.ready.then(function() { window.drawInfographic(); });
</script>
</body>
</html>
